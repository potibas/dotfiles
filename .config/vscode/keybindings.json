// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "cmd+j",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus"
  },
   {
    "key": "cmd+j",
    "command": "workbench.action.focusLastEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "cmd+j",
    "command": "-workbench.action.togglePanel"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorFocus"
  },
  {
    "key": "ctrl+/",
    "command": "editor.action.blockComment",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+\\",
    "command": "workbench.action.terminal.split",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+\\",
    "command": "workbench.action.terminal.focusNextPane",
    "when": "terminalFocus"
  },
  {
    "key": "cmd+k cmd+c",
    "command": "copyRelativeFilePath"
  },
  {
    "key": "cmd+k cmd+e",
    "command": "workbench.view.explorer"
  },
  {
    "key": "cmd+k cmd+x",
    "command": "workbench.view.extensions"
  },
  {
    "key": "cmd+k cmd+s",
    "command": "workbench.action.openGlobalKeybindingsFile"
  },
  {
    "key": "cmd+k cmd+g",
    "command": "workbench.view.scm"
  },
  {
    "key": "cmd+k s",
    "command": "workbench.action.openGlobalKeybindings"
  },
  {
    "key": "cmd+t cmd+y",
    "command": "exunit.runTest",
    "when": "editorLangId == 'elixir'"
  },
  {
    "key": "cmd+t cmd+f",
    "command": "exunit.runTestFile",
    "when": "editorLangId == 'elixir'"
  },
  {
    "key": "cmd+t cmd+t",
    "command": "exunit.runPrevious",
    "when": "editorLangId == 'elixir'"
  },
  {
    "key": "cmd+t cmd+y",
    "command": "better-phpunit.run",
    "when": "editorLangId == 'php'"
  },
  {
    "key": "cmd+t cmd+f",
    "command": "better-phpunit.run-file",
    "when": "editorLangId == 'php'"
  },
  {
    "key": "cmd+t cmd+t",
    "command": "better-phpunit.run-previous",
    "when": "editorLangId == 'php'"
  },
  {
    "key": "cmd+t cmd+a",
    "command": "better-phpunit.run-suite",
    "when": "editorLangId == 'php'"
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeWindow",
    "when": "!editorIsOpen && !multipleEditorGroups"
  },
  {
    "key": "cmd+k cmd+y",
    "command": "gitlens.openOnlyChangedFiles"
  }
]
